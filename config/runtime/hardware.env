# Physical-hardware runtime configuration.

# PX4 <-> ROS 2 uXRCE-DDS Agent connection.
# Device and baud settings describe the companion-computer serial link.
XRCE_AGENT_TRANSPORT=serial
XRCE_AGENT_DEVICE=/dev/serial/by-id/usb-FTDI_Quad_RS232-HS-if02-port0
XRCE_AGENT_BAUD=921600

START_XRCE_AGENT=true

# Vicon DataStream connection and ROS topic mapping.
VICON_HOSTNAME=192.168.50.108
VICON_BUFFER_SIZE=200
VICON_TOPIC_NAMESPACE=vicon
VICON_WORLD_FRAME=map
VICON_FRAME=vicon
VICON_MAP_XYZ="[0.0,0.0,0.0]"
VICON_MAP_RPY="[0.0,0.0,0.0]"
VICON_MAP_RPY_IN_DEGREES=false

# PoseStamped topic for the tracked vehicle.
MOCAP_TOPIC=/vicon/F450_2/F450_2
MOCAP_USE_HEADER_STAMP=true

# tmux session used by the hardware stack.
TMUX_SESSION=px4-hardware

# Independent MAVLink connection for the router and PX4 shell.
# No onboard parameters are applied automatically.
# auto detects one PX4 USB device; a named endpoint is preferable.
MAVLINK_MASTER=auto
MAVLINK_BAUD=115200
# Optional QGC UDP destination, e.g. 127.0.0.1:14550
MAVLINK_QGC_OUT=
