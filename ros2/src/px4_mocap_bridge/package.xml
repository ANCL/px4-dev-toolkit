<?xml version="1.0"?>
<package format="3">
  <name>px4_mocap_bridge</name>
  <version>0.1.0</version>
  <description>Bridge ROS 2 motion-capture poses into PX4 external odometry.</description>

  <maintainer email="mohssen.elshaar@gmail.com">Mohssene</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>eigen</build_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>px4_ros_com</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>vicon_receiver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
