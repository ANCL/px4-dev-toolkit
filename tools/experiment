#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "${ROOT}/config/runtime/common.env"
source "${ROOT}/config/runtime/experiment.env"

RUNTIME_ENV="${ROOT}/ros2/runtime_env.sh"
TMUX_CONFIG="${ROOT}/config/tmux.conf"

ACTION="${1:-}"

usage() {
    echo "Usage:"
    echo "  ./tools/experiment start"
    echo "  ./tools/experiment status"
    echo "  ./tools/experiment stop"
}

require_config_value() {
    local name="$1"

    if [[ -z "${!name-}" ]]; then
        echo "ERROR: missing ${name} in config/runtime/experiment.env." >&2
        exit 1
    fi
}

require_boolean() {
    local name="$1"
    local value="${!name-}"

    case "${value}" in
        true|false) ;;
        *)
            echo "ERROR: ${name} must be either 'true' or 'false'." >&2
            exit 1
            ;;
    esac
}

if (( $# != 1 )); then
    usage
    exit 2
fi

case "${ACTION}" in
    start|status|stop) ;;
    *)
        usage
        exit 2
        ;;
esac

require_config_value TMUX_SESSION

if ! command -v tmux >/dev/null 2>&1; then
    echo "ERROR: tmux is not installed." >&2
    exit 1
fi

session_exists() {
    tmux has-session -t "${TMUX_SESSION}" 2>/dev/null
}

# Launch-command contract:
#   Inputs: package, launch file, and ROS launch arguments.
#   Action: source the repository runtime inside the tmux pane, then exec the
#           launch process so tmux owns the actual ROS process tree.
#   Output: one shell-escaped command suitable for tmux.
ros_launch_command() {
    local package="$1"
    local launch_file="$2"
    shift 2

    local command
    local argument
    local escaped

    printf -v command \
        'source %q && exec ros2 launch %q %q' \
        "${RUNTIME_ENV}" \
        "${package}" \
        "${launch_file}"

    for argument in "$@"; do
        printf -v escaped ' %q' "${argument}"
        command+="${escaped}"
    done

    printf 'bash -lc %q' "${command}"
}

validate_start_config() {
    require_boolean START_XRCE_AGENT
    require_boolean VICON_MAP_RPY_IN_DEGREES
    require_boolean MOCAP_USE_HEADER_STAMP

    require_config_value VICON_HOSTNAME
    require_config_value VICON_BUFFER_SIZE
    require_config_value VICON_TOPIC_NAMESPACE
    require_config_value VICON_WORLD_FRAME
    require_config_value VICON_FRAME
    require_config_value VICON_MAP_XYZ
    require_config_value VICON_MAP_RPY
    require_config_value MOCAP_TOPIC

    if [[ "${START_XRCE_AGENT}" == "true" ]]; then
        require_config_value XRCE_AGENT_TRANSPORT
        require_config_value XRCE_AGENT_DEVICE
        require_config_value XRCE_AGENT_BAUD

        if [[ "${XRCE_AGENT_TRANSPORT}" != "serial" ]]; then
            echo "ERROR: experiment XRCE transport must be 'serial'." >&2
            exit 1
        fi

        if [[ ! "${XRCE_AGENT_BAUD}" =~ ^[1-9][0-9]*$ ]]; then
            echo "ERROR: XRCE_AGENT_BAUD must be a positive integer." >&2
            exit 1
        fi
    fi

    if [[ ! "${VICON_BUFFER_SIZE}" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: VICON_BUFFER_SIZE must be a positive integer." >&2
        exit 1
    fi

    if [[ ! -f "${RUNTIME_ENV}" ]]; then
        echo "ERROR: runtime environment script is missing:" >&2
        echo "  ${RUNTIME_ENV}" >&2
        exit 1
    fi

    if [[ ! -f "${TMUX_CONFIG}" ]]; then
        echo "ERROR: missing tmux config:" >&2
        echo "  ${TMUX_CONFIG}" >&2
        exit 1
    fi
}

start_stack() {
    if session_exists; then
        exec tmux attach-session -t "${TMUX_SESSION}"
    fi

    validate_start_config

    local mocap_command
    mocap_command="$(
        ros_launch_command \
            px4_mocap_bridge \
            mocap.launch.py \
            "hostname:=${VICON_HOSTNAME}" \
            "buffer_size:=${VICON_BUFFER_SIZE}" \
            "topic_namespace:=${VICON_TOPIC_NAMESPACE}" \
            "world_frame:=${VICON_WORLD_FRAME}" \
            "vicon_frame:=${VICON_FRAME}" \
            "map_xyz:=${VICON_MAP_XYZ}" \
            "map_rpy:=${VICON_MAP_RPY}" \
            "map_rpy_in_degrees:=${VICON_MAP_RPY_IN_DEGREES}" \
            "mocap_topic:=${MOCAP_TOPIC}" \
            "use_header_stamp:=${MOCAP_USE_HEADER_STAMP}"
    )"

    tmux new-session \
        -d \
        -s "${TMUX_SESSION}" \
        -n mocap \
        "${mocap_command}"

    if [[ "${START_XRCE_AGENT}" == "true" ]]; then
        local xrce_command
        xrce_command="$(
            ros_launch_command \
                px4_bringup \
                xrce.launch.py \
                "transport:=${XRCE_AGENT_TRANSPORT}" \
                "device:=${XRCE_AGENT_DEVICE}" \
                "baud:=${XRCE_AGENT_BAUD}"
        )"

        tmux new-window \
            -t "${TMUX_SESSION}:" \
            -n xrce-dds \
            "${xrce_command}"
    fi

    tmux source-file "${TMUX_CONFIG}"
    tmux select-window -t "${TMUX_SESSION}:mocap"

    echo "tmux session: ${TMUX_SESSION}"
    echo

    tmux list-windows \
        -t "${TMUX_SESSION}" \
        -F '  #I: #W'

    exec tmux attach-session -t "${TMUX_SESSION}"
}

pid_is_alive() {
    local pid="$1"
    local state

    [[ -r "/proc/${pid}/stat" ]] || return 1

    state="$(
        awk '{print $3}' "/proc/${pid}/stat" 2>/dev/null || true
    )"

    [[ -n "${state}" && "${state}" != "Z" ]]
}

# Process-tree contract:
#   Input:  one tmux pane/root PID.
#   Action: capture the complete descendant tree before tmux is destroyed.
#   Output: PIDs retained for deterministic shutdown even if parent shells exit.
collect_process_tree() {
    local root_pid="$1"
    local -a queue=("${root_pid}")
    local index=0
    local pid
    local child

    while (( index < ${#queue[@]} )); do
        pid="${queue[$index]}"
        index=$((index + 1))

        echo "${pid}"

        while IFS= read -r child; do
            [[ -n "${child}" ]] && queue+=("${child}")
        done < <(
            pgrep -P "${pid}" 2>/dev/null || true
        )
    done
}

any_pid_alive() {
    local pid

    for pid in "$@"; do
        if pid_is_alive "${pid}"; then
            return 0
        fi
    done

    return 1
}

wait_for_pids() {
    local timeout_seconds="$1"
    shift

    local elapsed=0

    while (( elapsed < timeout_seconds )); do
        if ! any_pid_alive "$@"; then
            return 0
        fi

        sleep 1
        elapsed=$((elapsed + 1))
    done

    ! any_pid_alive "$@"
}

signal_alive_pids() {
    local signal="$1"
    shift

    local pid

    for pid in "$@"; do
        if pid_is_alive "${pid}"; then
            kill -s "${signal}" "${pid}" 2>/dev/null || true
        fi
    done
}

# Shutdown contract:
#   Input:  the tmux-owned experiment process tree.
#   Action: request Ctrl-C first, then escalate SIGINT -> SIGTERM -> SIGKILL
#           only for processes that remain alive.
#   Output: no stale experiment process is allowed to contaminate the next run.
stop_stack() {
    if ! session_exists; then
        echo "tmux session '${TMUX_SESSION}' is not running."
        return 0
    fi

    local -a pane_pids=()
    local -a stack_pids=()
    local -a pane_targets=()

    local pane_pid
    local pid
    local target

    mapfile -t pane_pids < <(
        tmux list-panes \
            -s \
            -t "${TMUX_SESSION}" \
            -F '#{pane_pid}'
    )

    mapfile -t pane_targets < <(
        tmux list-panes \
            -s \
            -t "${TMUX_SESSION}" \
            -F '#{session_name}:#{window_name}.#{pane_index}'
    )

    for pane_pid in "${pane_pids[@]}"; do
        while IFS= read -r pid; do
            [[ -n "${pid}" ]] && stack_pids+=("${pid}")
        done < <(
            collect_process_tree "${pane_pid}"
        )
    done

    if (( ${#stack_pids[@]} > 0 )); then
        mapfile -t stack_pids < <(
            printf '%s\n' "${stack_pids[@]}" |
                sort -n -u
        )
    fi

    echo "Stopping tmux session '${TMUX_SESSION}'..."

    for target in "${pane_targets[@]}"; do
        tmux send-keys \
            -t "${target}" \
            C-c \
            2>/dev/null || true
    done

    if (( ${#stack_pids[@]} > 0 )) &&
        ! wait_for_pids 15 "${stack_pids[@]}"; then

        echo "Processes still running; sending SIGINT."
        signal_alive_pids INT "${stack_pids[@]}"

        if ! wait_for_pids 15 "${stack_pids[@]}"; then
            echo "Processes still running; sending SIGTERM."
            signal_alive_pids TERM "${stack_pids[@]}"

            if ! wait_for_pids 2 "${stack_pids[@]}"; then
                echo "Processes still running; sending SIGKILL."
                signal_alive_pids KILL "${stack_pids[@]}"
            fi
        fi
    fi

    tmux kill-session \
        -t "${TMUX_SESSION}" \
        2>/dev/null || true

    echo "tmux session '${TMUX_SESSION}' stopped."
}

xrce_processes() {
    pgrep -a -x MicroXRCEAgent 2>/dev/null || true
}

vicon_processes() {
    pgrep -af '[v]icon_client' 2>/dev/null || true
}

mocap_bridge_processes() {
    pgrep -af '[p]x4_mocap_bridge' 2>/dev/null || true
}

show_component_status() {
    local label="$1"
    local configured="$2"
    local process_function="$3"
    local processes

    processes="$("${process_function}")"

    if [[ -n "${processes}" ]]; then
        printf '%-18s running' "${label}:"

        if [[ "${configured}" != "always" ]]; then
            printf ' (configured %s)' "${configured}"
        fi

        echo

        while IFS= read -r line; do
            echo "  ${line}"
        done <<< "${processes}"
    else
        printf '%-18s stopped' "${label}:"

        if [[ "${configured}" != "always" ]]; then
            printf ' (configured %s)' "${configured}"
        fi

        echo
    fi
}

status_stack() {
    echo "tmux session: ${TMUX_SESSION}"

    if session_exists; then
        echo "state: running"

        tmux list-windows \
            -t "${TMUX_SESSION}" \
            -F '  #I: #W'
    else
        echo "state: stopped"
    fi

    echo

    show_component_status \
        "XRCE Agent" \
        "${START_XRCE_AGENT}" \
        xrce_processes

    show_component_status \
        "Vicon receiver" \
        "always" \
        vicon_processes

    show_component_status \
        "Mocap bridge" \
        "always" \
        mocap_bridge_processes
}

case "${ACTION}" in
    start)
        start_stack
        ;;
    stop)
        stop_stack
        ;;
    status)
        status_stack
        ;;
esac
