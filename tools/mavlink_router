#!/usr/bin/env bash
# Own exactly one PX4 MAVLink connection and route it to local clients.
# 14661: interactive PX4 shell
# 14662: independent parameter and trajectory CLI
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROUTER="${ROOT}/.venv/mavlink/bin/mavlink-routerd"
CONFIG="${ROOT}/config/mavlink-router.conf"
MODE="${1:-}"

if [[ "${MODE}" == "sitl" && ! -x "${ROUTER}" ]]; then
    echo "Install MAVLink tools: ./setup/install_mavlink.sh" >&2
    exit 1
fi

ARGS=(
    -c "${CONFIG}"
    -e 127.0.0.1:14661
    -e 127.0.0.1:14662
)

case "${MODE}" in
    sitl)
        # PX4's independent MAVLink API stream, not its GCS stream.
        SOURCE="127.0.0.1:14540"
        ;;

    hardware)
        source "${ROOT}/config/runtime/hardware.env"

        # Receive telemetry from the selected remote MAVLink IP only.
        # Send PX4 commands to the remote UDP client port. The other endpoints
        # remain private to this host for the shell and transfer tools.
        REMOTE_IP="${MAVLINK_REMOTE_IP:-}"
        REMOTE_PORT="${MAVLINK_REMOTE_PORT:-14555}"
        LISTEN_PORT="${MAVLINK_LISTEN_PORT:-14550}"

        [[ "${REMOTE_IP}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
            echo "Invalid MAVLINK_REMOTE_IP" >&2
            exit 1
        }
        for port in "${REMOTE_PORT}" "${LISTEN_PORT}"; do
            [[ "${port}" =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) || {
                echo "Invalid MAVLink UDP port: ${port}" >&2
                exit 1
            }
        done

        [[ -z "${MAVLINK_QGC_OUT:-}" ]] || {
            echo "MAVLINK_QGC_OUT is not supported by the IP-filtered MAVLink link." >&2
            echo "QGC receives the telemetry broadcast separately on another host." >&2
            exit 1
        }

        # Only packets originating from the selected MAVLink endpoint reach the
        # local tools. Ignore other drones on the same laboratory network.
        exec python3 "${ROOT}/tools/runtime/mavlink_udp_relay.py" \
            "${REMOTE_IP}" "${REMOTE_PORT}" "${LISTEN_PORT}"
        ;;

    *)
        echo "Usage: tools/mavlink_router sitl|hardware" >&2
        exit 2
        ;;
esac

echo "PX4 MAVLink source: ${SOURCE}"
echo "Shell: 127.0.0.1:14661"
echo "Transfers: 127.0.0.1:14662"

exec "${ROUTER}" "${ARGS[@]}" "${SOURCE}"
