#!/usr/bin/env bash
# Open the hardware MAVProxy console on a dedicated MAVLink endpoint.
# This script never sets parameters; the operator may load a .parm file.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${ROOT}/config/runtime/hardware.env"
VENV="${ROOT}/.venv/mavproxy"
PORT="${MAVLINK_MASTER:-auto}"
BAUD="${MAVLINK_BAUD:-115200}"
PROFILE="${ONBOARD_PROFILE:-f450_02}"

fail() {
    printf '\nMAVLink startup: %s\n' "$*" >&2
    echo 'Configure MAVLINK_MASTER in config/runtime/hardware.env.' >&2
    exec bash
}
[[ "$PROFILE" =~ ^[a-zA-Z0-9_]+$ ]] || fail 'invalid ONBOARD_PROFILE name'
[[ "$BAUD" =~ ^[1-9][0-9]*$ ]] || fail 'invalid MAVLINK_BAUD'
[[ -x "$VENV/bin/mavproxy.py" ]] || fail 'install MAVProxy using setup/install_mavproxy.sh'

# Autodetect only one known Pixhawk USB device; never share the XRCE serial link.
if [[ "$PORT" == auto ]]; then
    shopt -s nullglob
    CANDIDATES=()
    for p in /dev/serial/by-id/*; do
        case "${p##*/}" in
            *PX4*|*Pixhawk*|*pixhawk*|*Cube*|*cube*)
                [[ "$(readlink -f "$p")" != "$(readlink -f "${XRCE_AGENT_DEVICE:-/dev/null}")" ]] && CANDIDATES+=("$p") ;;
        esac
    done
    ((${#CANDIDATES[@]} == 1)) || fail "expected one PX4 USB device; found ${#CANDIDATES[@]}. Set MAVLINK_MASTER explicitly"
    PORT="${CANDIDATES[0]}"
fi
if [[ "$PORT" == "${XRCE_AGENT_DEVICE:-}" || "$(readlink -f "$PORT")" == "$(readlink -f "${XRCE_AGENT_DEVICE:-/dev/null}")" ]]; then
    fail 'MAVLink and XRCE-DDS must use different endpoints'
fi

ARGS=("--master=$PORT" "--baudrate=$BAUD" "--state-basedir=$ROOT/log/mavproxy")
ARGS+=("--out=udp:127.0.0.1:14655")
[[ -z "${MAVLINK_QGC_OUT:-}" ]] || ARGS+=("--out=$MAVLINK_QGC_OUT")
mkdir -p "$ROOT/log/mavproxy"
printf 'MAVProxy connecting: %s\n' "$PORT"
PROFILE_PATH="$ROOT/config/controllers/onboard/${PROFILE}.parm"
if [[ -f "$PROFILE_PATH" ]]; then
    printf 'Optional onboard parameter file: %s\n' "$PROFILE_PATH"
    echo 'After verifying system ID, airframe and disarmed state, type:'
    printf '    param diff %s\n' "$PROFILE_PATH"
    printf '    param load %s\n' "$PROFILE_PATH"
else
    printf 'No validated %s profile. Template: %s.example\n' "$PROFILE_PATH" "$PROFILE_PATH"
fi
echo 'To download logs manually: module load ftp ; ftp list /fs/microsd/log ; ftp get <remote> <local>'
exec "$VENV/bin/mavproxy.py" "${ARGS[@]}"
