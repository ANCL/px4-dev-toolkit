#!/usr/bin/python3 -s
"""Compare finalized ROS bags using recorded PX4 signals at trajectory time.

All controllers use the same measurements, tracking metrics and figures.
Offboard trajectories begin at confirmed Offboard entry; legacy native-SE3
recordings without execution-phase metadata require validated reference fitting.
"""
from __future__ import annotations

import argparse
from pathlib import Path
import sys


def find_repo_root() -> Path:
    """Locate the PX4 toolkit without relying on the caller's working directory."""
    start = Path(__file__).resolve()
    for candidate in (start.parent, *start.parents):
        if ((candidate / "config" / "px4_topics.def").is_file()
                and (candidate / "analysis").is_dir()
                and (candidate / "ros2").is_dir()):
            return candidate
    raise RuntimeError(f"Could not locate PX4 toolkit root from {start}")


ROOT = find_repo_root()
sys.path.insert(0, str(ROOT))

from analysis.trajectory_comparison import compare_bags  # noqa: E402


def default_study_output(bag_paths: list[Path]) -> Path:
    """Keep the existing per-study default; other comparisons require --output."""
    parents = {path.parent.resolve() for path in bag_paths}
    if len(parents) != 1:
        raise ValueError("Bags do not share one study bag directory; provide --output")
    bag_root = next(iter(parents))
    if bag_root.name != "bags" or not (bag_root.parent / "manifest.json").is_file():
        raise ValueError("Comparison output cannot be inferred for standalone bags; provide --output")
    return bag_root.parent / "comparison"


def main() -> int:
    parser = argparse.ArgumentParser(description="Compare PX4 experiments by trajectory start")
    parser.add_argument("bags", nargs="+", type=Path, help="Finalized ROS 2 bag directories")
    parser.add_argument("--output", type=Path, help="Comparison output directory")
    args = parser.parse_args()
    bag_paths = [path.expanduser().resolve() for path in args.bags]
    if len(bag_paths) < 2:
        raise ValueError("Comparison requires at least two bags")
    for path in bag_paths:
        if not (path / "metadata.yaml").is_file():
            raise ValueError(f"Not a finalized ROS 2 bag: {path}")
    output_dir = (args.output.expanduser().resolve() if args.output
                  else default_study_output(bag_paths))
    compare_bags(bag_paths, output_dir)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, RuntimeError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
