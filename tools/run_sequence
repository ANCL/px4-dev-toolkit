#!/usr/bin/python3 -s

"""Run ROS 2 launch experiments sequentially from a YAML configuration.

Runtime flow:
    sequence YAML
      -> validate ordered launch steps
      -> create one study directory
      -> launch each step in its own process group
      -> stream output to terminal + per-step log
      -> finalize rosbag metadata before advertising a bag in the manifest
      -> optionally settle between steps
      -> persist final study result

Process ownership:
    Each ros2 launch step owns a separate process group so interruption can
    terminate the complete launch tree rather than only its parent process.
"""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import time

import yaml


NAME_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+$")


def find_repo_root() -> Path:
    start = Path(__file__).resolve()

    for path in (start.parent, *start.parents):
        if (
            (path / "config" / "px4_topics.def").is_file()
            and (path / "config").is_dir()
            and (path / "ros2").is_dir()
        ):
            return path

    raise RuntimeError(
        f"Could not locate toolkit repository root from {start}"
    )


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def validate_name(value: object, field: str) -> str:
    if (
        not isinstance(value, str)
        or not value
        or NAME_PATTERN.fullmatch(value) is None
    ):
        raise ValueError(
            f"{field} must contain only letters, numbers, '.', '_' or '-'."
        )

    return value


def launch_value(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"

    if isinstance(value, (str, int, float)):
        return str(value)

    raise ValueError(
        "Launch argument values must be strings, numbers, or booleans."
    )


def load_sequence(path: Path) -> dict[str, object]:
    """Load and normalize one sequence definition.

    Inputs:
        YAML path describing profile, recording argument, settle time, and
        ordered launch steps.

    Method:
        Validate names and launch arguments before any study directory or
        process is created.

    Returns:
        Normalized sequence data suitable for deterministic execution.
    """
    if not path.is_file():
        raise ValueError(f"Sequence file does not exist: {path}")

    data = yaml.safe_load(path.read_text())

    if not isinstance(data, dict):
        raise ValueError("Sequence configuration must be a YAML mapping.")

    name = validate_name(data.get("name"), "Sequence name")

    profile = validate_name(
        data.get("profile"),
        "Sequence profile",
    )

    recording_output_argument = validate_name(
        data.get("recording_output_argument"),
        "Sequence recording_output_argument",
    )

    settle_seconds = data.get("settle_seconds", 0.0)

    if (
        not isinstance(settle_seconds, (int, float))
        or isinstance(settle_seconds, bool)
        or settle_seconds < 0.0
    ):
        raise ValueError(
            "settle_seconds must be a non-negative number."
        )

    raw_steps = data.get("steps")

    if not isinstance(raw_steps, list) or not raw_steps:
        raise ValueError("Sequence must define at least one step.")

    steps = []

    for index, raw_step in enumerate(raw_steps, start=1):
        if not isinstance(raw_step, dict):
            raise ValueError(
                f"Step {index} must be a YAML mapping."
            )

        step_name = validate_name(
            raw_step.get("name"),
            f"Step {index} name",
        )

        package = raw_step.get("package")
        launch = raw_step.get("launch")

        if not isinstance(package, str) or not package:
            raise ValueError(
                f"Step '{step_name}' requires a package."
            )

        if not isinstance(launch, str) or not launch:
            raise ValueError(
                f"Step '{step_name}' requires a launch file."
            )

        arguments = raw_step.get("arguments", {})

        if not isinstance(arguments, dict):
            raise ValueError(
                f"Step '{step_name}' arguments must be a mapping."
            )

        normalized_arguments = {
            str(key): launch_value(value)
            for key, value in arguments.items()
        }

        steps.append(
            {
                "name": step_name,
                "package": package,
                "launch": launch,
                "arguments": normalized_arguments,
            }
        )

    return {
        "name": name,
        "profile": profile,
        "recording_output_argument":
            recording_output_argument,
        "settle_seconds": float(settle_seconds),
        "steps": steps,
    }


def command_for_step(
    step: dict[str, object],
    overrides: dict[str, str] | None = None,
) -> list[str]:
    command = [
        "ros2",
        "launch",
        str(step["package"]),
        str(step["launch"]),
    ]

    arguments = dict(step["arguments"])

    if overrides:
        arguments.update(overrides)

    for key, value in arguments.items():
        command.append(f"{key}:={value}")

    return command


def launch_argument_is_true(
    arguments: dict[str, str],
    name: str,
) -> bool:
    return (
        arguments.get(name, "")
        .strip()
        .lower()
        in {
            "1",
            "true",
            "yes",
            "on",
        }
    )


def stop_process(process: subprocess.Popen[str]) -> None:
    """Stop one ROS launch process group.

    Input:
        Popen object whose PID is also the process-group leader.

    Method:
        Escalate SIGINT -> SIGTERM -> SIGKILL only when the group survives the
        previous shutdown stage.

    Returns:
        Nothing; the process is reaped before returning.
    """
    if process.poll() is not None:
        return

    try:
        os.killpg(process.pid, signal.SIGINT)
        process.wait(timeout=5.0)
        return
    except (ProcessLookupError, subprocess.TimeoutExpired):
        pass

    try:
        os.killpg(process.pid, signal.SIGTERM)
        process.wait(timeout=3.0)
        return
    except (ProcessLookupError, subprocess.TimeoutExpired):
        pass

    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass

    process.wait()


def write_manifest(path: Path, manifest: dict[str, object]) -> None:
    path.write_text(
        json.dumps(
            manifest,
            indent=2,
            sort_keys=False,
        )
        + "\n"
    )


def write_experiment_metadata(
    bag_path: Path,
    profile: str,
    sequence_name: str,
    step: dict[str, object],
) -> None:
    """Write immutable analysis context beside one finalized sequence bag.

    The metadata records profile, sequence/step identity, and effective launch
    arguments so later analysis does not infer controller configuration from
    downstream PX4 topics.
    """
    experiment_path = (
        bag_path / "experiment.json"
    )

    experiment = {
        "profile": profile,
        "sequence": sequence_name,
        "step": str(step["name"]),
        "arguments": dict(step["arguments"]),
    }

    experiment_path.write_text(
        json.dumps(
            experiment,
            indent=2,
        )
        + "\n"
    )


def run_step(
    command: list[str],
    log_path: Path,
) -> int:
    """Run one experiment step while preserving process and log ownership.

    Inputs:
        Complete ros2 launch command and the step log path.

    Method:
        Start the launch in its own process group, stream combined output to
        both terminal and log, and stop the whole group on interruption.

    Returns:
        Launch-process exit status.
    """
    print()
    print("$", " ".join(command))
    print()

    with log_path.open("w") as log:
        # ros2 launch can create several descendants. A new session gives the
        # step its own process group so interruption can stop the complete
        # launch tree rather than only the parent process.
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            start_new_session=True,
        )

        assert process.stdout is not None

        try:
            for line in process.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                log.write(line)
                log.flush()

            return process.wait()

        except KeyboardInterrupt:
            stop_process(process)
            raise


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run ROS 2 launch experiments sequentially."
    )

    parser.add_argument(
        "sequence",
        type=Path,
        help="YAML sequence configuration.",
    )

    args = parser.parse_args()

    if shutil.which("ros2") is None:
        raise RuntimeError(
            "ros2 is not available. Source ros2/runtime_env.sh first."
        )

    root = find_repo_root()
    config_path = args.sequence.expanduser().resolve()
    sequence = load_sequence(config_path)

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

    run_dir = (
        root
        / "bags"
        / str(sequence["name"])
        / timestamp
    )

    run_dir.mkdir(parents=True, exist_ok=False)

    logs_dir = run_dir / "logs"
    logs_dir.mkdir()

    bags_dir = run_dir / "bags"
    bags_dir.mkdir()

    manifest_path = run_dir / "manifest.json"

    manifest = {
        "sequence": sequence["name"],
        "configuration": str(config_path),
        "started_at": utc_now(),
        "finished_at": None,
        "settle_seconds": sequence["settle_seconds"],
        "result": "running",
        "steps": [],
    }

    write_manifest(manifest_path, manifest)

    print(f"Sequence: {sequence['name']}")
    print(f"Study directory: {run_dir}")

    try:
        for index, step in enumerate(sequence["steps"], start=1):
            recording_output = None
            command_overrides = {}

            if launch_argument_is_true(
                step["arguments"],
                "record",
            ):
                # Give every recorded step a deterministic bag directory owned
                # by this study. The launch file receives it as an override
                # instead of independently creating a timestamped path.
                recording_output = (
                    bags_dir
                    / f"{index:02d}-{step['name']}"
                )

                command_overrides[
                    str(
                        sequence[
                            "recording_output_argument"
                        ]
                    )
                ] = str(
                    recording_output.resolve()
                )

            command = command_for_step(
                step,
                command_overrides,
            )

            log_path = (
                logs_dir
                / f"{index:02d}-{step['name']}.log"
            )

            record = {
                "index": index,
                "name": step["name"],
                "command": command,
                "log": str(log_path.relative_to(run_dir)),
                "started_at": utc_now(),
                "finished_at": None,
                "exit_code": None,
                "recorded_bags": [],
            }

            # Persist the running step before launch so an interrupted study
            # still records which command was active and where its log lives.
            manifest["steps"].append(record)
            write_manifest(manifest_path, manifest)

            print()
            print(
                f"===== STEP {index}/{len(sequence['steps'])}: "
                f"{step['name']} ====="
            )

            exit_code = run_step(
                command,
                log_path,
            )

            record["finished_at"] = utc_now()
            record["exit_code"] = exit_code

            if recording_output is not None:
                metadata_path = (
                    recording_output
                    / "metadata.yaml"
                )

                if metadata_path.is_file():
                    # metadata.yaml is rosbag's completion contract. Only after
                    # it exists does the toolkit attach experiment metadata and
                    # advertise the bag as finalized in the study manifest.
                    write_experiment_metadata(
                        recording_output,
                        str(sequence["profile"]),
                        str(sequence["name"]),
                        step,
                    )

                    record["recorded_bags"] = [
                        str(
                            recording_output.relative_to(
                                run_dir
                            )
                        )
                    ]

                elif exit_code == 0:
                    manifest["result"] = "failed"
                    manifest["finished_at"] = utc_now()

                    write_manifest(
                        manifest_path,
                        manifest,
                    )

                    print(
                        "ERROR: step "
                        f"'{step['name']}' exited successfully "
                        "but its expected bag was not finalized: "
                        f"{recording_output}",
                        file=sys.stderr,
                    )

                    return 1

            write_manifest(manifest_path, manifest)

            if exit_code != 0:
                manifest["result"] = "failed"
                manifest["finished_at"] = utc_now()
                write_manifest(manifest_path, manifest)

                print(
                    f"ERROR: step '{step['name']}' exited "
                    f"with status {exit_code}.",
                    file=sys.stderr,
                )

                return exit_code or 1

            if index < len(sequence["steps"]):
                settle_seconds = float(
                    sequence["settle_seconds"]
                )

                if settle_seconds > 0.0:
                    print(
                        f"Settling for "
                        f"{settle_seconds:.1f} s..."
                    )
                    time.sleep(settle_seconds)

    except KeyboardInterrupt:
        manifest["result"] = "interrupted"
        manifest["finished_at"] = utc_now()
        write_manifest(manifest_path, manifest)

        print(
            "\nSequence interrupted.",
            file=sys.stderr,
        )
        return 130

    manifest["result"] = "success"
    manifest["finished_at"] = utc_now()
    write_manifest(manifest_path, manifest)

    print()
    print("Sequence complete.")
    print(f"Manifest: {manifest_path}")

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, ValueError, yaml.YAMLError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
