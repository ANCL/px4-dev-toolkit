#!/usr/bin/env bash
# Source the workspace before running the ROS 2 Python topic-rate monitor.
# Its statistics describe host callback arrivals, not message timestamps.
set -eo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "${ROOT}/ros2/runtime_env.sh"

exec /usr/bin/python3 -s "${ROOT}/tools/topic_rates.py" "$@"
