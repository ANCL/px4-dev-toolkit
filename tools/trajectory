#!/usr/bin/env python3
"""Compile and deploy trajectory plans through the active MAVProxy route.

Both SITL and hardware receive identical bytes over MAVLink FTP. Upload never
selects a flight mode, arms PX4, or starts trajectory execution.
"""

from __future__ import annotations

import argparse
import os
import tempfile
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "tools/trajectory_lib"))

# MAVLink FTP uses the same pinned pymavlink that MAVProxy was validated with.
# Re-execute the CLI in its existing venv instead of depending on user Python.
MAVPROXY_ENV = ROOT / ".venv/mavproxy"
if __name__ == "__main__" and Path(sys.prefix).resolve() != MAVPROXY_ENV.resolve():
    python = MAVPROXY_ENV / "bin/python"
    if not python.is_file():
        raise SystemExit("MAVProxy Python environment missing; run ./setup/install.sh sitl|hardware")
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])

import yaml  # noqa: E402
from compiler import compile_plan  # noqa: E402
from tools.transfer.connection import Connection, TRAJECTORY_DIR, TransferError, MissingDirectory, trajectory_names  # noqa: E402

DEFINITIONS = ROOT / "config/trajectories.yaml"
GENERATED = ROOT / "generated/trajectories"


def write_atomic(path: Path, data: bytes):
    """Replace a compiled plan only after writing and syncing complete bytes."""
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temp = tempfile.mkstemp(prefix=".trajectory-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    for command in ("upload", "compile"):
        option = sub.add_parser(command)
        chosen = option.add_mutually_exclusive_group(required=True)
        chosen.add_argument("name", nargs="?")
        chosen.add_argument("--all", action="store_true")
    sub.add_parser("list")
    sub.add_parser("clean", help="remove compiled files and remote catalog .traj files (disarmed only)")
    args = parser.parse_args()

    try:
        config = yaml.safe_load(DEFINITIONS.read_text())
        catalog = config["trajectories"]
        if args.command == "list":
            for name in sorted(catalog):
                print(name)
            return 0
        if args.command == "clean":
            link = Connection.open()
            try:
                link.require_disarmed()
                try:
                    remote = trajectory_names(link.entries(TRAJECTORY_DIR))
                except MissingDirectory:
                    remote = []
                print(f"Removing {len(remote)} remote trajectory files:")
                for path in remote:
                    link.remove(path)
                    print(f"  removed {path}")
                for path in sorted(GENERATED.glob("*.traj")):
                    if not path.is_symlink():
                        path.unlink()
                        print(f"  removed {path}")
            finally:
                link.close()
            return 0
        names = sorted(catalog) if args.all else [args.name]
        if any(name not in catalog for name in names):
            raise TransferError("unknown trajectory; run tools/trajectory list")
        compiled = {name: compile_plan(config, name).encode("ascii") for name in names}
        GENERATED.mkdir(parents=True, exist_ok=True)
        if args.command == "compile":
            for name, content in compiled.items():
                path = GENERATED / (name + ".traj")
                write_atomic(path, content)
                print(f"Compiled: {path}")
            return 0
        link = Connection.open()
        try:
            link.require_disarmed()
            link.ensure_directory(TRAJECTORY_DIR)
            for name, content in compiled.items():
                path = GENERATED / (name + ".traj")
                write_atomic(path, content)
                remote = TRAJECTORY_DIR + "/" + path.name
                crc = link.upload(path, remote)
                print(f"Uploaded and verified: {name} -> {remote} (CRC32 {crc:08x})")
        finally:
            link.close()
        return 0
    except (ValueError, KeyError, OSError, yaml.YAMLError, TransferError) as error:
        print(f"trajectory: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
